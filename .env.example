# Copy to .env (cp .env.example .env). Never commit .env.
# These are local-development defaults only; change the password if you like.

# Backend
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (used by both docker-compose.yml and the backend)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=retailpulse_dev_password
POSTGRES_DB=retailpulse

# Ollama (local AI). Install from https://ollama.com, then:
#   ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=60000
RAG_MAX_DISTANCE=0.4

# DEMO ONLY: shared manager PIN for approving/rejecting inventory proposals.
# This is a hackathon stand-in, not real authentication.
DEMO_MANAGER_PIN=demo-manager
